{
  "name": "@jeremy-hibiki/pi-magpie-provider",
  "version": "0.1.0",
  "description": "Pi provider extension for magpie: local or remote magpie gateways as model providers, with their live catalog.",
  "keywords": [
    "gateway",
    "llm",
    "magpie",
    "omp",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "provider"
  ],
  "homepage": "https://github.com/Jeremy-Hibiki/pi-magpie-provider#readme",
  "bugs": {
    "url": "https://github.com/Jeremy-Hibiki/pi-magpie-provider/issues"
  },
  "license": "MIT",
  "author": "Jeremy <JeremyJiang430@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jeremy-Hibiki/pi-magpie-provider.git"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "pnpm test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
